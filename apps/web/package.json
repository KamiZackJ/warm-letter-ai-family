{
  "name": "@warm-letter/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:test",
    "build:competition": "tsc -b && vite build --mode competition",
    "build:demo": "tsc -b && vite build --mode demo",
    "build:production": "tsc -b && vite build --mode production",
    "build:test": "tsc -b && vite build --mode test",
    "dev": "vite --host 127.0.0.1 --mode demo",
    "dev:competition": "vite --host 127.0.0.1 --mode competition",
    "dev:test": "vite --host 127.0.0.1 --mode test",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "verify:production-bundle": "node scripts/verify-production-bundle.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "vite": "^7.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
