.reader-page {
  min-height: 100vh;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  background: #e9e5dc;
}

.reader-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 14rpx 32rpx;
  border-bottom: 2rpx solid #d3cfc6;
  background: #f4f1ea;
}

.toolbar-label {
  flex: none;
  color: #5e6561;
  font-size: 24rpx;
  font-weight: 650;
}

.font-controls {
  display: flex;
  gap: 8rpx;
}

.font-button {
  width: 112rpx;
  height: 88rpx;
  padding: 0;
  border: 2rpx solid #d0cdc5;
  border-radius: 6rpx;
  background: #fff;
  color: #5e6461;
  font-size: 28rpx;
  line-height: 1.2;
}

.font-button.is-active {
  border-color: #245a4b;
  background: #245a4b;
  color: #fff;
}

.reader-loading {
  padding: 100rpx 32rpx;
  color: #5d6661;
  text-align: center;
}

.reader-error {
  min-height: calc(100vh - 124rpx);
  padding: 96rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #3f4b46;
  text-align: center;
}

.reader-error-title,
.reader-error-detail {
  display: block;
}

.reader-error-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.reader-error-detail {
  max-width: 620rpx;
  margin-top: 18rpx;
  color: #59635e;
  font-size: 28rpx;
  line-height: 1.65;
}

.reader-error-actions {
  width: 100%;
  max-width: 620rpx;
  margin-top: 34rpx;
  display: flex;
  gap: 16rpx;
}

.reader-error-actions button {
  flex: 1;
  min-width: 0;
}

.letter-paper {
  margin: 24rpx 20rpx 0;
  padding: 48rpx 38rpx 58rpx;
  border: 2rpx solid #d8d1c3;
  border-radius: 6rpx;
  background: #fffdf8;
  box-shadow: 0 8rpx 24rpx rgba(62, 55, 44, 0.07);
}

.letter-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #e3dfd6;
  color: #557067;
  font-size: 22rpx;
  font-weight: 650;
}

.ai-disclosure {
  flex: none;
  padding: 5rpx 10rpx;
  border-radius: 6rpx;
  background: #e5ece8;
  color: #245a4b;
  font-size: 20rpx;
}

.letter-heading,
.letter-date,
.letter-salutation,
.letter-paragraph,
.letter-closing,
.letter-signature {
  display: block;
}

.letter-heading {
  margin-top: 40rpx;
  color: #26362f;
  font-family: serif;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
}

.letter-date {
  margin-top: 12rpx;
  color: #666d68;
  font-size: 21rpx;
  text-align: center;
}

.letter-salutation {
  margin-top: 52rpx;
  font-family: serif;
  font-weight: 650;
}

.letter-body {
  margin-top: 24rpx;
}

.letter-paragraph {
  margin-top: 24rpx;
  font-family: serif;
  line-height: 1.95;
  text-align: justify;
}

.paragraph-source {
  margin-top: 12rpx;
  border-top: 2rpx solid #e3dfd6;
}

.paragraph-source-toggle,
.paragraph-source-empty {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  min-height: 88rpx;
  padding: 12rpx 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.45;
  text-align: left;
}

.paragraph-source-empty {
  grid-template-columns: auto minmax(0, 1fr);
  min-height: 68rpx;
}

.paragraph-source-kicker {
  color: #245a4b;
  font-size: 22rpx;
  font-weight: 700;
}

.paragraph-source-summary {
  min-width: 0;
  color: #606863;
  font-size: 24rpx;
  overflow-wrap: anywhere;
}

.paragraph-source-action {
  width: 180rpx;
  color: #245a4b;
  font-size: 23rpx;
  font-weight: 650;
  text-align: right;
  white-space: nowrap;
}

.paragraph-source-list {
  padding: 0 0 12rpx 26rpx;
  border-left: 4rpx solid #b8cec3;
}

.paragraph-source-row {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #e3dfd6;
}

.paragraph-source-row:last-child {
  border-bottom: 0;
}

.paragraph-source-row.is-unavailable {
  color: #7d302b;
}

.paragraph-source-type,
.paragraph-source-name {
  font-size: 24rpx;
  line-height: 1.5;
}

.paragraph-source-type {
  font-weight: 650;
}

.paragraph-source-name {
  min-width: 0;
  overflow-wrap: anywhere;
}

.letter-closing {
  margin-top: 36rpx;
  font-family: serif;
  line-height: 1.85;
}

.letter-signature {
  margin-top: 34rpx;
  font-family: serif;
  font-weight: 650;
  text-align: right;
}

.font-normal .letter-salutation,
.font-normal .letter-paragraph,
.font-normal .letter-closing,
.font-normal .letter-signature {
  font-size: 40rpx;
}

.font-large .letter-salutation,
.font-large .letter-paragraph,
.font-large .letter-closing,
.font-large .letter-signature {
  font-size: 46rpx;
}

.font-extra .letter-salutation,
.font-extra .letter-paragraph,
.font-extra .letter-closing,
.font-extra .letter-signature {
  font-size: 52rpx;
}

.media-band,
.evidence-band,
.reply-band {
  padding: 42rpx 32rpx;
  border-top: 2rpx solid #d4d0c7;
  background: #f4f1ea;
}

.band-title {
  display: block;
  margin-bottom: 22rpx;
  color: #303532;
  font-size: 31rpx;
  font-weight: 700;
}

.image-strip {
  width: 100%;
  white-space: nowrap;
}

.image-item {
  display: inline-flex;
  flex-direction: column;
  width: 248rpx;
  height: 322rpx;
  margin-right: 18rpx;
  text-align: left;
  vertical-align: top;
}

.image-preview,
.letter-image,
.image-placeholder {
  width: 248rpx;
  height: 264rpx;
  border-radius: 6rpx;
}

.image-preview {
  position: relative;
  overflow: hidden;
  padding: 0;
  background: #e7e2d7;
}

.letter-image {
  display: block;
}

.image-loading {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(244, 241, 234, 0.92);
  color: #59635e;
  font-size: 24rpx;
}

.image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 14rpx;
  border: 2rpx solid #d0ccc2;
  background: #e7e2d7;
  color: #74756f;
  text-align: center;
}

.image-placeholder-text {
  font-size: 22rpx;
  line-height: 1.35;
  white-space: normal;
}

.image-retry-button {
  width: 190rpx;
  height: 88rpx;
  padding: 0 12rpx;
  border: 2rpx solid #245a4b;
  border-radius: 6rpx;
  background: #fff;
  color: #245a4b;
  font-size: 24rpx;
  line-height: 1.2;
}

.image-name {
  display: block;
  overflow: hidden;
  margin-top: 10rpx;
  color: #5e6460;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.voice-item {
  border-top: 2rpx solid #d5d1c8;
}

.voice-row {
  display: grid;
  grid-template-columns: 86rpx minmax(0, 1fr);
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 104rpx;
  padding: 12rpx 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.voice-control {
  color: #245a4b;
  font-size: 25rpx;
  font-weight: 700;
}

.voice-info {
  min-width: 0;
}

.voice-name,
.voice-duration {
  display: block;
}

.voice-name {
  font-size: 28rpx;
  font-weight: 650;
}

.voice-duration {
  margin-top: 5rpx;
  color: #5f6863;
  font-size: 22rpx;
}

.media-action-error,
.reply-action-error {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  border: 2rpx solid #a64b42;
  border-radius: 6rpx;
  background: #fff6f4;
  color: #7d302b;
}

.media-action-error {
  margin: 0 0 18rpx;
}

.media-action-error-text,
.reply-action-error-text {
  min-width: 0;
  font-size: 25rpx;
  line-height: 1.5;
}

.media-retry-button,
.reply-retry-button {
  min-width: 180rpx;
  height: 88rpx;
  padding: 0 18rpx;
  border: 2rpx solid #7d302b;
  border-radius: 6rpx;
  background: #fff;
  color: #7d302b;
  font-size: 25rpx;
  line-height: 1.2;
}

.evidence-note {
  display: block;
  margin-top: -10rpx;
  color: #616865;
  font-size: 24rpx;
  line-height: 1.55;
}

.evidence-list {
  margin-top: 20rpx;
  border-top: 2rpx solid #d5d1c8;
}

.evidence-row {
  display: grid;
  grid-template-columns: 130rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 17rpx 0;
  border-bottom: 2rpx solid #d5d1c8;
  font-size: 25rpx;
}

.evidence-type {
  color: #245a4b;
  font-weight: 650;
}

.evidence-name {
  min-width: 0;
  color: #555b57;
}

.reply-input {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #d1cec5;
  border-radius: 8rpx;
  background: #fff;
  color: #292c2a;
  font-size: 30rpx;
  line-height: 1.6;
}

.reply-input-meta {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 10rpx;
  color: #626b66;
  font-size: 24rpx;
  line-height: 1.5;
}

.reply-helper {
  min-width: 0;
  overflow-wrap: anywhere;
}

.reply-count {
  flex: none;
  min-width: 160rpx;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.reply-button {
  width: 100%;
  margin-top: 16rpx;
}

.reply-action-error {
  margin-top: 18rpx;
}

.reply-list {
  margin-top: 32rpx;
  border-top: 2rpx solid #d5d1c8;
}

.reply-row {
  padding: 22rpx 0;
  border-bottom: 2rpx solid #d5d1c8;
}

.reply-author-name,
.reply-text,
.reply-date {
  display: block;
}

.reply-author-name {
  margin-bottom: 8rpx;
  color: #5f6a65;
  font-size: 24rpx;
}

.reply-text {
  font-size: 29rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.reply-date {
  margin-top: 8rpx;
  color: #5f6763;
  font-size: 22rpx;
}

.font-large .letter-status,
.font-large .letter-date,
.font-large .ai-disclosure,
.font-large .image-name,
.font-large .voice-duration,
.font-large .reply-author-name,
.font-large .reply-date {
  font-size: 25rpx;
}

.font-extra .letter-status,
.font-extra .letter-date,
.font-extra .ai-disclosure,
.font-extra .image-name,
.font-extra .voice-duration,
.font-extra .reply-author-name,
.font-extra .reply-date {
  font-size: 28rpx;
}

.font-large .image-placeholder-text,
.font-large .media-action-error-text,
.font-large .reply-action-error-text,
.font-large .paragraph-source-kicker,
.font-large .paragraph-source-action,
.font-large .reply-helper,
.font-large .reply-count {
  font-size: 28rpx;
}

.font-extra .image-placeholder-text,
.font-extra .media-action-error-text,
.font-extra .reply-action-error-text,
.font-extra .paragraph-source-kicker,
.font-extra .paragraph-source-action,
.font-extra .reply-helper,
.font-extra .reply-count {
  font-size: 31rpx;
}

.font-large .band-title,
.font-large .voice-name,
.font-large .evidence-note,
.font-large .evidence-row,
.font-large .reply-text {
  font-size: 32rpx;
}

.font-extra .band-title,
.font-extra .voice-name,
.font-extra .evidence-note,
.font-extra .evidence-row,
.font-extra .reply-text {
  font-size: 36rpx;
}

.font-large .paragraph-source-summary,
.font-large .paragraph-source-type,
.font-large .paragraph-source-name {
  font-size: 30rpx;
}

.font-extra .paragraph-source-summary,
.font-extra .paragraph-source-type,
.font-extra .paragraph-source-name {
  font-size: 34rpx;
}

.font-large .reply-input {
  min-height: 174rpx;
  font-size: 34rpx;
}

.font-extra .reply-input {
  min-height: 198rpx;
  font-size: 38rpx;
}

.font-large .reader-error-title {
  font-size: 42rpx;
}

.font-extra .reader-error-title {
  font-size: 46rpx;
}

.font-large .reader-error-detail {
  font-size: 32rpx;
}

.font-extra .reader-error-detail {
  font-size: 36rpx;
}
