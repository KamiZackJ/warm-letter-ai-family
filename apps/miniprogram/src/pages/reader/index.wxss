.reader-page {
  min-height: 100vh;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  background: #e9e5dc;
}

.reader-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 14rpx 32rpx;
  border-bottom: 2rpx solid #d3cfc6;
  background: #f4f1ea;
}

.toolbar-label {
  flex: none;
  color: #5e6561;
  font-size: 24rpx;
  font-weight: 650;
}

.font-controls {
  display: flex;
  gap: 8rpx;
}

.font-button {
  width: 112rpx;
  height: 88rpx;
  padding: 0;
  border: 2rpx solid #d0cdc5;
  border-radius: 6rpx;
  background: #fff;
  color: #5e6461;
  font-size: 28rpx;
  line-height: 1.2;
}

.font-button.is-active {
  border-color: #245a4b;
  background: #245a4b;
  color: #fff;
}

.reader-loading {
  padding: 100rpx 32rpx;
  color: #737975;
  text-align: center;
}

.letter-paper {
  margin: 24rpx 20rpx 0;
  padding: 48rpx 38rpx 58rpx;
  border: 2rpx solid #d8d1c3;
  border-radius: 6rpx;
  background: #fffdf8;
  box-shadow: 0 8rpx 24rpx rgba(62, 55, 44, 0.07);
}

.letter-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #e3dfd6;
  color: #557067;
  font-size: 22rpx;
  font-weight: 650;
}

.ai-disclosure {
  flex: none;
  padding: 5rpx 10rpx;
  border-radius: 6rpx;
  background: #e5ece8;
  color: #245a4b;
  font-size: 20rpx;
}

.letter-heading,
.letter-date,
.letter-salutation,
.letter-paragraph,
.letter-closing,
.letter-signature {
  display: block;
}

.letter-heading {
  margin-top: 40rpx;
  color: #26362f;
  font-family: serif;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
}

.letter-date {
  margin-top: 12rpx;
  color: #838782;
  font-size: 21rpx;
  text-align: center;
}

.letter-salutation {
  margin-top: 52rpx;
  font-family: serif;
  font-weight: 650;
}

.letter-body {
  margin-top: 24rpx;
}

.letter-paragraph {
  margin-top: 24rpx;
  font-family: serif;
  line-height: 1.95;
  text-align: justify;
}

.letter-closing {
  margin-top: 36rpx;
  font-family: serif;
  line-height: 1.85;
}

.letter-signature {
  margin-top: 34rpx;
  font-family: serif;
  font-weight: 650;
  text-align: right;
}

.font-normal .letter-salutation,
.font-normal .letter-paragraph,
.font-normal .letter-closing,
.font-normal .letter-signature {
  font-size: 40rpx;
}

.font-large .letter-salutation,
.font-large .letter-paragraph,
.font-large .letter-closing,
.font-large .letter-signature {
  font-size: 46rpx;
}

.font-extra .letter-salutation,
.font-extra .letter-paragraph,
.font-extra .letter-closing,
.font-extra .letter-signature {
  font-size: 52rpx;
}

.media-band,
.evidence-band,
.reply-band {
  padding: 42rpx 32rpx;
  border-top: 2rpx solid #d4d0c7;
  background: #f4f1ea;
}

.band-title {
  display: block;
  margin-bottom: 22rpx;
  color: #303532;
  font-size: 31rpx;
  font-weight: 700;
}

.image-strip {
  width: 100%;
  white-space: nowrap;
}

.image-item {
  display: inline-flex;
  flex-direction: column;
  width: 248rpx;
  height: 242rpx;
  margin-right: 18rpx;
  padding: 0;
  border-radius: 6rpx;
  background: transparent;
  text-align: left;
  vertical-align: top;
}

.letter-image,
.image-placeholder {
  width: 248rpx;
  height: 184rpx;
  border-radius: 6rpx;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d0ccc2;
  background: #e7e2d7;
  color: #74756f;
  font-size: 28rpx;
}

.image-name {
  display: block;
  overflow: hidden;
  margin-top: 10rpx;
  color: #5e6460;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.voice-row {
  display: grid;
  grid-template-columns: 86rpx minmax(0, 1fr);
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 104rpx;
  padding: 12rpx 0;
  border-top: 2rpx solid #d5d1c8;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.voice-control {
  color: #245a4b;
  font-size: 25rpx;
  font-weight: 700;
}

.voice-info {
  min-width: 0;
}

.voice-name,
.voice-duration {
  display: block;
}

.voice-name {
  font-size: 28rpx;
  font-weight: 650;
}

.voice-duration {
  margin-top: 5rpx;
  color: #747a76;
  font-size: 22rpx;
}

.evidence-note {
  display: block;
  margin-top: -10rpx;
  color: #6c726f;
  font-size: 24rpx;
  line-height: 1.55;
}

.evidence-list {
  margin-top: 20rpx;
  border-top: 2rpx solid #d5d1c8;
}

.evidence-row {
  display: grid;
  grid-template-columns: 130rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 17rpx 0;
  border-bottom: 2rpx solid #d5d1c8;
  font-size: 25rpx;
}

.evidence-type {
  color: #245a4b;
  font-weight: 650;
}

.evidence-name {
  min-width: 0;
  color: #555b57;
}

.reply-input {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #d1cec5;
  border-radius: 8rpx;
  background: #fff;
  color: #292c2a;
  font-size: 30rpx;
  line-height: 1.6;
}

.reply-button {
  width: 100%;
  margin-top: 16rpx;
}

.reply-list {
  margin-top: 32rpx;
  border-top: 2rpx solid #d5d1c8;
}

.reply-row {
  padding: 22rpx 0;
  border-bottom: 2rpx solid #d5d1c8;
}

.reply-text,
.reply-date {
  display: block;
}

.reply-text {
  font-size: 29rpx;
  line-height: 1.6;
}

.reply-date {
  margin-top: 8rpx;
  color: #787d7a;
  font-size: 22rpx;
}
