.materials-page {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.demo-button {
  width: 100%;
  min-height: 88rpx;
  margin-top: 28rpx;
  border: 2rpx solid #9eb6ab;
  border-radius: 8rpx;
  background: #e5eee9;
  color: #245a4b;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.35;
}

.source-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: minmax(220rpx, auto);
  gap: 16rpx;
}

.source-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 220rpx;
  padding: 20rpx 16rpx;
  border: 2rpx solid #d6d3cb;
  border-radius: 8rpx;
  background: #fff;
}

.source-button.is-recording {
  border-color: #aa5a4d;
  background: #fbf1ef;
}

.source-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #e4ece8;
  color: #245a4b;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.source-name,
.source-note {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  white-space: normal;
  text-align: center;
}

.source-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.35;
}

.source-note {
  margin-top: 6rpx;
  color: #5f6561;
  font-size: 28rpx;
  line-height: 1.45;
}

.material-textarea {
  min-height: 150rpx;
}

.add-text-button {
  width: 100%;
  margin-top: 14rpx;
}

.action-errors {
  margin-top: 30rpx;
}

.action-error,
.load-error {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  padding: 26rpx 0;
  border-top: 2rpx solid #cda9a2;
  border-bottom: 2rpx solid #cda9a2;
}

.action-error + .action-error {
  border-top: 0;
}

.load-error {
  margin-top: 30rpx;
}

.action-error-title,
.action-error-message,
.action-error-hint,
.load-error-title,
.load-error-message,
.load-error-hint {
  display: block;
}

.action-error-title,
.load-error-title {
  color: #65352f;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
}

.action-error-message,
.load-error-message {
  color: #4f5552;
  font-size: 25rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.action-error-hint,
.load-error-hint {
  color: #68706c;
  font-size: 23rpx;
  line-height: 1.55;
}

.action-retry,
.load-retry {
  min-width: 220rpx;
  min-height: 88rpx;
  margin-top: 6rpx;
}

.selected-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.selected-count {
  color: #737975;
  font-size: 24rpx;
}

.material-list {
  border-top: 2rpx solid #d8d5cd;
}

.material-row {
  display: grid;
  grid-template-columns: 70rpx minmax(0, 1fr) 88rpx;
  align-items: start;
  gap: 16rpx;
  min-height: 128rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #d8d5cd;
}

.material-type {
  padding-top: 8rpx;
  color: #245a4b;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.4;
}

.material-main {
  min-width: 0;
  padding: 4rpx 0;
}

.material-name,
.material-detail {
  display: -webkit-box;
  overflow: hidden;
  overflow-wrap: anywhere;
  white-space: normal;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.material-name {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
}

.material-detail {
  margin-top: 6rpx;
  color: #616763;
  font-size: 28rpx;
  line-height: 1.45;
}

.remove-button {
  align-self: center;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  color: #8a3e34;
  font-size: 23rpx;
  line-height: 88rpx;
}
