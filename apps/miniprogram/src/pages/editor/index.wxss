.editor-page {
  padding-bottom: calc(174rpx + env(safe-area-inset-bottom));
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 8rpx;
}

.title-row .page-title {
  min-width: 0;
  margin-top: 0;
}

.ai-mark {
  flex: none;
  padding: 7rpx 13rpx;
  border-radius: 6rpx;
  background: #e2ece7;
  color: #245a4b;
  font-size: 21rpx;
  font-weight: 700;
}

.loading-state {
  margin-top: 40rpx;
}

.generation-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 40rpx;
  padding: 30rpx 0;
  border-top: 2rpx solid #c7c4bc;
  border-bottom: 2rpx solid #c7c4bc;
}

.generation-state-title {
  color: #2f3431;
  font-size: 30rpx;
  font-weight: 700;
}

.generation-state-message,
.generation-state-hint {
  color: #4f5552;
  font-size: 25rpx;
  line-height: 1.6;
}

.retry-generation {
  min-width: 220rpx;
  min-height: 88rpx;
  margin-top: 8rpx;
}

.editor-section {
  margin-top: 30rpx;
}

.title-input {
  font-weight: 650;
}

.paragraphs-section {
  margin-top: 36rpx;
}

.paragraph-editor {
  padding: 26rpx 0 30rpx;
  border-top: 2rpx solid #d2cfc7;
}

.paragraph-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.paragraph-number {
  color: #4f5552;
  font-size: 25rpx;
  font-weight: 650;
}

.delete-paragraph {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  background: transparent;
  color: #8a3e34;
  font-size: 23rpx;
  line-height: 88rpx;
}

.paragraph-textarea {
  min-height: 190rpx;
}

.source-trace {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 12rpx;
  color: #67716c;
  font-size: 22rpx;
  line-height: 1.5;
}

.source-label {
  flex: none;
  color: #245a4b;
  font-weight: 700;
}

.source-value {
  min-width: 0;
}

.attribution-review {
  margin-top: 16rpx;
  padding: 18rpx;
  border-left: 6rpx solid #b8cec3;
  background: #f2f6f2;
}

.attribution-hint {
  display: block;
  color: #4f5552;
  font-size: 23rpx;
  line-height: 1.55;
}

.source-choice-list {
  display: grid;
  gap: 10rpx;
  margin-top: 14rpx;
}

.source-choice {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  color: #2f3431;
  font-size: 24rpx;
  line-height: 1.4;
}

.source-choice checkbox {
  flex: none;
}

.source-choice-name {
  min-width: 0;
  margin-left: 10rpx;
  overflow-wrap: anywhere;
}

.personal-supplement-button,
.source-review-button {
  min-height: 72rpx;
  padding: 10rpx 0;
  background: transparent;
  color: #245a4b;
  font-size: 23rpx;
  line-height: 1.4;
  text-align: left;
  text-decoration: underline;
}

.personal-supplement-button {
  margin-top: 10rpx;
}

.source-review-button {
  width: auto;
  margin-top: 10rpx;
}

.add-paragraph {
  width: 100%;
}

.compact-textarea {
  min-height: 138rpx;
}

.regenerate-button {
  width: 100%;
  min-height: 88rpx;
  margin-top: 30rpx;
  padding: 16rpx 20rpx;
  background: transparent;
  color: #5f6763;
  font-size: 25rpx;
  line-height: 1.35;
  text-decoration: underline;
}
