<view class="page editor-page">
  <view class="environment-banner environment-banner-{{environmentMode}}" aria-label="{{environmentLabel}}，{{environmentDetail}}">
    <text class="environment-label">{{environmentLabel}}</text>
    <text class="environment-detail">{{environmentDetail}}</text>
  </view>
  <text class="eyebrow">第 3 步，共 4 步</text>
  <view class="title-row">
    <text class="page-title">逐段确认草稿</text>
    <text class="ai-mark">AI 辅助生成</text>
  </view>
  <text class="page-subtitle">来源提示帮助你核对事实。下一步会先看到完整预览，再决定是否寄出。</text>

  <view wx:if="{{loading}}" class="empty-state loading-state" aria-live="polite">
    {{generationPending ? '家书正在后台整理…' : '正在打开草稿…'}}
  </view>
  <view wx:elif="{{errorMessage}}" class="generation-state" aria-role="alert">
    <text class="generation-state-title">暂时还不能编辑</text>
    <text class="generation-state-message">{{errorMessage}}</text>
    <text class="generation-state-hint">后台任务会保留，继续查看不会重复提交。</text>
    <button class="secondary-button retry-generation" bindtap="loadLetter" aria-label="继续查看家书生成进度">继续查看</button>
  </view>
  <block wx:else>
    <view wx:if="{{audioTranscripts.length}}" class="transcript-review section">
      <text class="field-label">核对语音文字</text>
      <text class="transcript-hint">语音识别可能有误。请核对下面的原话，尤其是时间、数字和描述程度；有误可直接修改。</text>
      <view wx:for="{{audioTranscripts}}" wx:key="materialId" class="transcript-item">
        <view class="transcript-heading">
          <text class="transcript-name">{{item.name}}</text>
          <text class="transcript-status">{{item.text !== item.savedText ? '未保存' : item.confirmed ? '已核对' : '待核对'}}</text>
        </view>
        <textarea class="textarea transcript-textarea" aria-label="核对{{item.name}}的语音文字" data-material-id="{{item.materialId}}" maxlength="50000" value="{{item.text}}" disabled="{{transcriptSaving || generationPending || saving}}" bindinput="updateAudioTranscript" />
      </view>
      <text wx:if="{{audioTranscriptRevisionPending}}" class="transcript-pending" aria-live="polite">语音文字已保存，需重新生成家书后才能预览和寄出。</text>
      <text wx:if="{{transcriptError}}" class="transcript-error" aria-role="alert">{{transcriptError}}</text>
      <button class="secondary-button transcript-save" loading="{{transcriptSaving}}" disabled="{{transcriptSaving || generationPending || saving}}" bindtap="saveTranscriptsAndRegenerate">{{transcriptSaving ? (generationPending ? '已保存，正在重新生成…' : '正在保存语音文字…') : '保存并重新生成'}}</button>
      <text class="transcript-hint">核对后的文字用于整理家书，重新生成会覆盖当前草稿修改。</text>
    </view>

    <view class="section editor-section">
      <text class="field-label">标题</text>
      <input class="input title-input" aria-label="标题" data-field="title" maxlength="40" value="{{draft.title}}" bindinput="updateField" />
    </view>

    <view class="section editor-section">
      <text class="field-label">称呼</text>
      <input class="input" aria-label="称呼" data-field="salutation" maxlength="30" value="{{draft.salutation}}" bindinput="updateField" />
    </view>

    <view class="paragraphs-section">
    <view wx:for="{{draft.paragraphs}}" wx:for-index="paragraphIndex" wx:key="id" class="paragraph-editor">
      <view class="paragraph-heading">
          <text class="paragraph-number">正文 {{paragraphIndex + 1}}</text>
          <button class="delete-paragraph" data-index="{{paragraphIndex}}" bindtap="removeParagraph">删除</button>
        </view>
        <textarea class="textarea paragraph-textarea" aria-label="正文第 {{paragraphIndex + 1}} 段" data-index="{{paragraphIndex}}" maxlength="1000" value="{{item.text}}" bindinput="updateParagraph" />
        <view class="source-trace">
          <text class="source-label">内容归因</text>
          <text class="source-value">{{paragraphAttributionViews[paragraphIndex].label}}</text>
        </view>
        <view wx:if="{{paragraphAttributionViews[paragraphIndex].needsReview || paragraphAttributionViews[paragraphIndex].sourcePickerOpen}}" class="attribution-review" aria-live="polite">
          <text class="attribution-hint">{{paragraphAttributionViews[paragraphIndex].hint}}</text>
          <checkbox-group class="source-choice-list" data-index="{{paragraphIndex}}" bindchange="updateParagraphSources">
            <label wx:for="{{paragraphAttributionViews[paragraphIndex].sourceChoices}}" wx:key="id" wx:for-item="source" class="source-choice">
              <checkbox value="{{source.id}}" checked="{{source.selected}}" color="#245A4B" />
              <text class="source-choice-name">{{source.name}}</text>
            </label>
          </checkbox-group>
          <button class="source-review-button" data-index="{{paragraphIndex}}" bindtap="confirmParagraphSources">内容无误，已核对所选素材</button>
          <button class="personal-supplement-button" data-index="{{paragraphIndex}}" bindtap="markParagraphUserSupplied">标记为本人补充</button>
        </view>
        <button wx:else class="source-review-button" data-index="{{paragraphIndex}}" bindtap="beginParagraphSourceReview">重新核对依据</button>
      </view>
      <button class="quiet-button add-paragraph" bindtap="addParagraph">添加一段</button>
    </view>

    <view class="section editor-section">
      <text class="field-label">结尾</text>
      <textarea class="textarea compact-textarea" aria-label="结尾" data-field="closing" maxlength="300" value="{{draft.closing}}" bindinput="updateField" />
    </view>

    <view class="section editor-section">
      <text class="field-label">署名</text>
      <input class="input" aria-label="署名" data-field="signature" maxlength="30" value="{{draft.signature}}" bindinput="updateField" />
    </view>

    <text wx:if="{{generationError}}" class="transcript-error" aria-role="alert">{{generationError}}。当前草稿和已保存的语音文字会保留，可再次重新生成。</text>
    <button class="secondary-button regenerate-button" loading="{{generationPending}}" disabled="{{generationPending || saving || transcriptSaving}}" bindtap="regenerate">{{generationPending ? '正在重新生成…' : audioTranscriptRevisionPending ? '重新生成家书' : '换一版文字'}}</button>
    <text class="regenerate-helper">不满意当前表达时使用，会覆盖尚未保存的修改。</text>
  </block>

  <view wx:if="{{!loading && !errorMessage}}" class="sticky-actions">
    <button class="secondary-button" loading="{{saving}}" disabled="{{saving || loading || generationPending || transcriptSaving}}" bindtap="saveDraft">保存</button>
    <button class="primary-button" loading="{{saving}}" disabled="{{saving || loading || generationPending || transcriptSaving || audioTranscriptRevisionPending || audioTranscriptUnsaved}}" bindtap="previewLetter">预览家书</button>
  </view>
</view>
