<template name="guideBubble">
  <view class="guide-bubble guide-bubble-step-{{guideStep}}">
    <view aria-live="polite">
      <text class="guide-progress">第 {{guideStep + 1}} 步，共 {{guideStepCount}} 步</text>
      <text class="guide-body">{{guideContent.body}}</text>
    </view>
    <view class="guide-actions">
      <button class="guide-skip" bindtap="dismissGuide">跳过</button>
      <button wx:if="{{guideStep < guideStepCount - 1}}" class="guide-next" bindtap="nextGuideStep">下一步</button>
      <button wx:else class="guide-next" bindtap="dismissGuide">知道了</button>
    </view>
  </view>
</template>

<view class="page home-page">
  <view class="brand-band">
    <text class="brand-name">暖笺</text>
    <text class="brand-line">把没来得及说的话，写成一封家书。</text>
    <view id="guide-write" class="write-entry">
      <button class="primary-button main-action" loading="{{startingFlow}}" disabled="{{startingFlow}}" bindtap="startLetter">{{startingFlow ? '正在打开…' : '写一封家书'}}</button>
      <template wx:if="{{guideVisible && guideStep === 0}}" is="guideBubble" data="{{guideStep, guideStepCount, guideContent}}" />
    </view>
  </view>

  <view class="trust-row" aria-label="隐私与内容说明">
    <view class="trust-item">
      <text class="trust-value">主动选择</text>
      <text class="trust-label">只使用你添加的素材</text>
    </view>
    <view class="trust-item">
      <text class="trust-value">先审后寄</text>
      <text class="trust-label">AI 草稿由你最终确认</text>
    </view>
  </view>

  <view id="guide-recent" class="section recent-section">
    <view class="section-heading">
      <text class="section-title">最近家书</text>
      <text class="section-note">可在这里继续写</text>
    </view>
    <template wx:if="{{guideVisible && guideStep === 1}}" is="guideBubble" data="{{guideStep, guideStepCount, guideContent}}" />

    <view wx:if="{{loadError}}" class="recent-error" aria-role="alert" aria-live="assertive">
      <text class="recent-error-title">暂时无法读取最近家书</text>
      <text class="recent-error-message">{{loadError}}</text>
      <text class="recent-error-hint">可以重新读取，也可以先写一封新家书。</text>
      <button
        class="secondary-button recent-retry"
        loading="{{loading}}"
        disabled="{{loading}}"
        bindtap="retryLetters"
      >重新读取</button>
    </view>
    <view wx:if="{{loading && recentLetters.length === 0}}" class="empty-state" aria-live="polite">正在读取最近家书…</view>
    <view wx:elif="{{recentLetters.length === 0 && !loadError}}" class="empty-state">
      还没有家书。添加几张照片或一段近况，就可以开始。
    </view>
    <view wx:elif="{{recentLetters.length > 0}}" class="letter-list">
      <button
        wx:for="{{recentLetters}}"
        wx:key="id"
        class="letter-row"
        data-id="{{item.id}}"
        data-status="{{item.status}}"
        bindtap="openLetter"
      >
        <view class="letter-main">
          <text class="letter-title">{{item.title}}</text>
          <text class="letter-meta">{{item.dateLabel}} · {{item.intent.recipient}}</text>
        </view>
        <text class="status-pill">{{item.statusLabel}}</text>
        <text class="row-arrow" aria-hidden="true">›</text>
      </button>
    </view>
  </view>
  <view id="guide-replay" class="guide-replay">
    <button class="guide-entry" disabled="{{startingFlow}}" bindtap="openGuide">使用指南</button>
    <template wx:if="{{guideVisible && guideStep === 2}}" is="guideBubble" data="{{guideStep, guideStepCount, guideContent}}" />
  </view>
</view>
