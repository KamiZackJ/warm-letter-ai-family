.home-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.brand-band {
  padding: 56rpx 0 44rpx;
  border-bottom: 2rpx solid #d8d5cd;
}

.brand-name {
  display: block;
  color: #244f43;
  font-family: serif;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.15;
}

.brand-line {
  display: block;
  margin-top: 20rpx;
  color: #535955;
  font-size: 31rpx;
  line-height: 1.7;
}

.main-action {
  width: 100%;
  margin-top: 48rpx;
}

.demo-link {
  width: 100%;
  height: 72rpx;
  margin-top: 10rpx;
  background: transparent;
  color: #52645e;
  font-size: 25rpx;
  line-height: 72rpx;
  text-decoration: underline;
}

.trust-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #d8d5cd;
}

.trust-item {
  min-width: 0;
}

.trust-value,
.trust-label {
  display: block;
}

.trust-value {
  color: #245a4b;
  font-size: 27rpx;
  font-weight: 650;
}

.trust-label {
  margin-top: 6rpx;
  color: #6a706c;
  font-size: 23rpx;
  line-height: 1.45;
}

.recent-section {
  margin-top: 34rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
}

.section-note {
  color: #7a7f7c;
  font-size: 22rpx;
}

.letter-list {
  border-top: 2rpx solid #d8d5cd;
}

.letter-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto 28rpx;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #d8d5cd;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.letter-main {
  min-width: 0;
}

.letter-title,
.letter-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.letter-title {
  font-size: 29rpx;
  font-weight: 650;
}

.letter-meta {
  margin-top: 8rpx;
  color: #747976;
  font-size: 23rpx;
}

.row-arrow {
  color: #747976;
  font-size: 40rpx;
  text-align: right;
}
