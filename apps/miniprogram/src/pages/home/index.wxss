.home-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.guide-bubble {
  position: relative;
  width: 100%;
  min-width: 0;
  margin-top: 12px;
  padding: 14px 16px 10px;
  border: 1px solid #b9cbbf;
  border-radius: 10px;
  background: #e8f0e9;
  color: #244f43;
}

.guide-bubble::before {
  content: "";
  position: absolute;
  top: -6px;
  left: 24px;
  width: 10px;
  height: 10px;
  border-top: 1px solid #b9cbbf;
  border-left: 1px solid #b9cbbf;
  background: #e8f0e9;
  transform: rotate(45deg);
}

.guide-bubble-step-0::before,
.guide-bubble-step-2::before {
  left: calc(50% - 5px);
}

.guide-progress,
.guide-body {
  display: block;
  overflow-wrap: anywhere;
}

.guide-progress {
  color: #535955;
  font-size: 14px;
  line-height: 1.5;
}

.guide-body {
  margin-top: 6px;
  font-size: 18px;
  line-height: 1.55;
}

.guide-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 8px;
}

.guide-actions > button.guide-skip,
.guide-actions > button.guide-next {
  flex: 0 0 auto;
  width: auto;
  max-width: 100%;
  min-width: 76px;
  min-height: 44px;
  margin: 0;
  padding: 10px 16px;
  border-radius: 6px;
  font-size: 18px;
  line-height: 1.35;
  white-space: normal;
  overflow-wrap: anywhere;
}

.guide-skip {
  background: transparent;
  color: #244f43;
}

.guide-next {
  background: #244f43;
  color: #ffffff;
}

.guide-replay {
  margin-top: 28px;
}

.guide-entry {
  width: 100%;
  min-height: 48px;
  padding: 12px 16px;
  background: transparent;
  color: #244f43;
  font-size: 18px;
  line-height: 1.5;
  text-decoration: underline;
  white-space: normal;
  overflow-wrap: anywhere;
}

.guide-next:focus,
.guide-skip:focus,
.guide-entry:focus {
  outline: 2px solid #244f43;
  outline-offset: 3px;
}

.brand-band {
  padding: 56rpx 0 44rpx;
  border-bottom: 2rpx solid #d8d5cd;
}

.brand-name {
  display: block;
  color: #244f43;
  font-family: serif;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.15;
}

.brand-line {
  display: block;
  margin-top: 20rpx;
  color: #535955;
  font-size: 31rpx;
  line-height: 1.7;
}

.write-entry {
  margin-top: 48rpx;
}

.home-page .write-entry > button.main-action {
  width: 100%;
  margin: 0;
}

.trust-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #d8d5cd;
}

.trust-item {
  min-width: 0;
}

.trust-value,
.trust-label {
  display: block;
}

.trust-value {
  color: #245a4b;
  font-size: 27rpx;
  font-weight: 650;
}

.trust-label {
  margin-top: 6rpx;
  color: #6a706c;
  font-size: 23rpx;
  line-height: 1.45;
}

.recent-section {
  margin-top: 34rpx;
}

.recent-error {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 26rpx 0;
  border-top: 2rpx solid #cda9a2;
  border-bottom: 2rpx solid #cda9a2;
}

.recent-error-title,
.recent-error-message,
.recent-error-hint {
  display: block;
}

.recent-error-title {
  color: #65352f;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
}

.recent-error-message {
  color: #4f5552;
  font-size: 25rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.recent-error-hint {
  color: #68706c;
  font-size: 23rpx;
  line-height: 1.55;
}

.recent-retry {
  min-width: 220rpx;
  min-height: 88rpx;
  margin-top: 6rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 24rpx;
}

.section-note {
  color: #535955;
  font-size: 28rpx;
  line-height: 1.45;
}

.letter-list {
  border-top: 2rpx solid #d8d5cd;
}

.letter-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto 28rpx;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #d8d5cd;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.letter-main {
  min-width: 0;
}

.letter-title,
.letter-meta {
  display: -webkit-box;
  overflow: hidden;
  overflow-wrap: anywhere;
  white-space: normal;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.letter-title {
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
}

.letter-meta {
  margin-top: 8rpx;
  color: #616763;
  font-size: 26rpx;
  line-height: 1.5;
}

.row-arrow {
  color: #747976;
  font-size: 40rpx;
  text-align: right;
}
