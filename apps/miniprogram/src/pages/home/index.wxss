.home-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.brand-band {
  padding: 56rpx 0 44rpx;
  border-bottom: 2rpx solid #d8d5cd;
}

.brand-name {
  display: block;
  color: #244f43;
  font-family: serif;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.15;
}

.brand-line {
  display: block;
  margin-top: 20rpx;
  color: #535955;
  font-size: 31rpx;
  line-height: 1.7;
}

.main-action {
  width: 100%;
  margin-top: 48rpx;
}

.demo-link {
  width: 100%;
  min-height: 88rpx;
  margin-top: 10rpx;
  padding: 16rpx 20rpx;
  background: transparent;
  color: #52645e;
  font-size: 25rpx;
  line-height: 1.35;
  text-decoration: underline;
}

.trust-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #d8d5cd;
}

.trust-item {
  min-width: 0;
}

.trust-value,
.trust-label {
  display: block;
}

.trust-value {
  color: #245a4b;
  font-size: 27rpx;
  font-weight: 650;
}

.trust-label {
  margin-top: 6rpx;
  color: #6a706c;
  font-size: 23rpx;
  line-height: 1.45;
}

.recent-section {
  margin-top: 34rpx;
}

.recent-error {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 26rpx 0;
  border-top: 2rpx solid #cda9a2;
  border-bottom: 2rpx solid #cda9a2;
}

.recent-error-title,
.recent-error-message,
.recent-error-hint {
  display: block;
}

.recent-error-title {
  color: #65352f;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
}

.recent-error-message {
  color: #4f5552;
  font-size: 25rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.recent-error-hint {
  color: #68706c;
  font-size: 23rpx;
  line-height: 1.55;
}

.recent-retry {
  min-width: 220rpx;
  min-height: 88rpx;
  margin-top: 6rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 24rpx;
}

.section-note {
  color: #535955;
  font-size: 28rpx;
  line-height: 1.45;
}

.letter-list {
  border-top: 2rpx solid #d8d5cd;
}

.letter-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto 28rpx;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #d8d5cd;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.letter-main {
  min-width: 0;
}

.letter-title,
.letter-meta {
  display: -webkit-box;
  overflow: hidden;
  overflow-wrap: anywhere;
  white-space: normal;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.letter-title {
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
}

.letter-meta {
  margin-top: 8rpx;
  color: #616763;
  font-size: 26rpx;
  line-height: 1.5;
}

.row-arrow {
  color: #747976;
  font-size: 40rpx;
  text-align: right;
}
