.privacy-page { padding-bottom: calc(48px + env(safe-area-inset-bottom)); }
.policy-section { margin-top: 28px; padding-top: 22px; border-top: 1px solid #d8d5cd; }
.policy-section > text { display: block; font-size: 18px; line-height: 1.8; overflow-wrap: anywhere; }
.policy-section > .section-title { color: #244f43; font-size: 21px; font-weight: 650; }
.policy-section button { margin-top: 20px; min-height: 48px; font-size: 18px; }
.filing { display: block; margin-top: 32px; color: #535955; font-size: 15px; line-height: 1.6; }
button:focus { outline: 2px solid #244f43; outline-offset: 3px; }
