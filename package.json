{
  "name": "warm-letter-ai-family",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm test",
    "dev:api": "pnpm --filter @warm-letter/api dev",
    "dev:web": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-web-demo.ps1",
    "dev:web:synthetic": "pnpm --filter @warm-letter/web dev",
    "dev:web:case-001": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-controlled-case-reader.ps1",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
