DEPLOYMENT_MODE=demo
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=https://api.warmjiashu.xyz
CORS_ORIGINS=https://warmjiashu.xyz,https://www.warmjiashu.xyz,https://kamizackj.github.io

# The public demo starts with deterministic generation until a real provider key is supplied.
AI_PROVIDER=fake
AUTH_PROVIDER=wechat
WECHAT_APP_ID=wx281b5275e4a1601f
WECHAT_APP_SECRET=replace-on-server
WECHAT_AUTH_TIMEOUT_MS=5000
WECHAT_CODE2SESSION_ENDPOINT=https://api.weixin.qq.com/sns/jscode2session

UPLOAD_DIR=/var/lib/warm-letter/uploads
MAX_MEDIA_UPLOAD_BYTES=26214400
SHARE_TOKEN_TTL_SECONDS=2592000
MEDIA_TOKEN_TTL_SECONDS=300
MEDIA_SIGNING_KEYS=replace-with-at-least-32-random-bytes-in-base64url

PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_MAX_BUCKETS=10000
PUBLIC_READER_RATE_LIMIT_PER_IP=120
PUBLIC_READER_RATE_LIMIT_PER_CREDENTIAL=60
PUBLIC_MEDIA_RATE_LIMIT_PER_IP=600
PUBLIC_MEDIA_RATE_LIMIT_PER_CREDENTIAL=300
PUBLIC_REPLY_RATE_LIMIT_PER_IP=20
PUBLIC_REPLY_RATE_LIMIT_PER_CREDENTIAL=5
REPLY_SAFETY_TIMEOUT_MS=3000
